# Development defaults. Copy to .env (git-ignored): cp .env.example .env
POSTGRES_USER=upfinance
POSTGRES_PASSWORD=upfinance
POSTGRES_DB=upfinance
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Replace outside local development
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=8

# Host port for PostgreSQL, change if 5432 is taken
DB_PORT=5432
